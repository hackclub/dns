#!/usr/bin/env python3
"""
sorting script for dns records

usage:
bin/sort-zones             # sort all
bin/sort-zones --check     # check only
bin/sort-zones foo.yaml    # sort one file
"""

import sys
from pathlib import Path

from natsort import natsort_keygen
from ruamel.yaml import YAML

_NATSORT_KEY = natsort_keygen()

def KEYGEN(key):
    if key is None:
        s = "null"
    elif isinstance(key, str) and key:
        s = ".".join(reversed(key.split(".")))
    else:
        s = str(key)
    return _NATSORT_KEY(s)


REPO_ROOT = Path(__file__).resolve().parent.parent
# Skip non-zone YAML files
SKIP_DIRS = {"config", ".github"}


def get():
    return sorted(
        p
        for p in REPO_ROOT.glob("*.yaml")
        if p.is_file()
    )


def sort(path, check_only=False):
    yaml = YAML()
    yaml.preserve_quotes = True

    # Disable newline translation: record blocks must retain their original bytes.
    with open(path, newline="") as f:
        raw = f.read()

    data = yaml.load(raw)
    if data is None:
        return True

    keys = list(data.keys())
    sorted_keys = sorted(keys, key=KEYGEN)

    if keys == sorted_keys:
        return True

    if check_only:
        for i, (got, expected) in enumerate(zip(keys, sorted_keys)):
            if got != expected:
                got_display = "''" if isinstance(got, str) and got == '' else ('null' if got is None else got)
                exp_display = "''" if isinstance(expected, str) and expected == '' else ('null' if expected is None else expected)
                print(f"  {path.name}: key {got_display} is out of order (expected {exp_display})")
                break
        return False

    lines = raw.splitlines(keepends=True)
    starts = [data.lc.key(key)[0] for key in keys]
    if data.fa.flow_style() or len(set(starts)) != len(starts):
        raise ValueError(f"{path}: expected a top-level block mapping")

    # Keep the preamble fixed. Between records, unindented standalone comments
    # describe the following key, not the preceding value. Leave blank lines
    # before those comments alone: they may belong to a |+ block scalar.
    for i in range(1, len(starts)):
        cursor = starts[i] - 1
        while cursor > starts[i - 1]:
            line = lines[cursor]
            if line.startswith("#"):
                starts[i] = cursor
            elif line.strip():
                break
            cursor -= 1

    # An explicit document end (and anything after it) is not part of a record.
    end = next(
        (i for i in range(starts[-1], len(lines))
         if lines[i].rstrip("\r\n") == "..."),
        len(lines),
    )
    blocks = {
        key: "".join(lines[start:stop])
        for key, start, stop in zip(keys, starts, starts[1:] + [end])
    }
    ordered = [blocks[key] for key in sorted_keys]
    newline = "\r\n" if "\r\n" in raw else "\n"
    # A record at EOF may lack a terminating newline. Supply a separator when
    # moving it into the middle, while retaining the file's EOF newline style.
    for i in range(len(ordered) - 1):
        if not ordered[i].endswith(("\n", "\r")):
            ordered[i] += newline
    result = "".join(lines[:starts[0]]) + "".join(ordered) + "".join(lines[end:])
    if not raw.endswith(("\n", "\r")) and result.endswith(newline):
        result = result[:-len(newline)]

    with open(path, "w", newline="") as f:
        f.write(result)

    return False


def main():
    check_only = "--check" in sys.argv
    args = [a for a in sys.argv[1:] if not a.startswith("-")]

    if args:
        files = [Path(a).resolve() for a in args]
    else:
        files = get()

    unsorted = []
    for path in files:
        was_sorted = sort(path, check_only=check_only)
        if not was_sorted:
            unsorted.append(path)

    if check_only:
        if unsorted:
            print(f"\n{len(unsorted)} file(s) have keys out of order")
            sys.exit(1)
        else:
            print("all files are in order")
            sys.exit(0)
    else:
        if unsorted:
            for p in unsorted:
                print(f"sorted: {p.name}")
            print(f"\n{len(unsorted)} file(s) sorted")
        else:
            print("all files were already in order")


if __name__ == "__main__":
    main()
